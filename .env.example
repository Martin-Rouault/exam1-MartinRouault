# Copier ce fichier en .env et renseigner les valeurs (.env est ignoré par Git).

# --- Backend ---
PORT=5000
# Local hors Docker : mongodb://127.0.0.1:27017/exam1Db
# Docker Compose : surchargé automatiquement (mongodb://mongo:27017/exam1Db)
# Préprod / prod : URI MongoDB Atlas (mongodb+srv://...)
MONGO_URI=mongodb://127.0.0.1:27017/exam1Db
# Secret long et aléatoire (32 caractères minimum, sinon le backend refuse de démarrer).
# Générer : openssl rand -hex 64 — un secret différent par environnement (local, préprod, prod)
JWT_SECRET=
GATEWAY_URL=http://localhost:8000
# Origines autorisées à appeler l'API (séparées par des virgules)
CORS_ORIGIN=http://localhost:3000
# Derrière le proxy d'un hébergeur (Render…) : 1. Laisser vide en local.
TRUST_PROXY=

# --- Clé partagée backend ↔ microservices (en-tête x-internal-token) ---
# Générer : openssl rand -hex 32 — même valeur pour backend, notifications et stock-management
INTERNAL_API_KEY=

# --- Gateway ---
GATEWAY_PORT=8000
NOTIFI_SERVICE_URL=http://localhost:4002
STOCK_SERVICE_URL=http://localhost:4003

# --- Microservice notifications (SMTP Gmail) ---
EMAIL_USER=
EMAIL_APPLICATION_PASSWORD=

# --- Frontend (utilisé au build) ---
REACT_APP_API_URL=http://localhost:5000/api
