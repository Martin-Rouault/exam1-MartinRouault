{
  "source": {
    "include": ["server.js", "config", "controllers", "middlewares", "models", "routes", "validators"],
    "exclude": ["node_modules", "docs", "tests", "controllers/adminController.js", "routes/adminRoutes.js"],
    "includePattern": "\\.js$"
  },
  "opts": {
    "destination": "docs",
    "recurse": true,
    "encoding": "utf8",
    "readme": "../README.md"
  },
  "tags": {
    "allowUnknownTags": true
  },
  "plugins": ["plugins/markdown"]
}
